# GainARK OntoLeap — W3C SHACL Governance Shapes
# Enforces structural integrity, provenance attribution, and taxonomy soundness.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <https://gainark.com/ontology/> .

# 1. Every capability node must carry a verbatim evidence quote
onto:EvidenceQuoteShape
    a sh:NodeShape ;
    sh:targetSubjectsOf prov:wasQuotedFrom ;
    sh:property [
        sh:path prov:wasQuotedFrom ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Evidence quote must be a non-empty string." ;
    ] .

# 2. Every capability claim must have a primary source or derivation link
onto:ClaimProvenanceShape
    a sh:NodeShape ;
    sh:targetSubjectsOf onto:groundingStatus ;
    sh:or (
        [
            sh:path prov:hadPrimarySource ;
            sh:minCount 1 ;
        ]
        [
            sh:path prov:wasDerivedFrom ;
            sh:minCount 1 ;
        ]
    ) ;
    sh:message "Every governed claim must have either prov:hadPrimarySource or prov:wasDerivedFrom." .

# 3. Verified Truth must have dual derivation (both marketing and technical)
onto:VerifiedTruthDerivationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf onto:groundingStatus ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claims marked as VERIFIED_TRUTH must derive from at least 2 distinct sources (marketing + technical)." ;
        sh:prefixes [
            sh:declare [
                sh:prefix "onto" ;
                sh:namespace "https://gainark.com/ontology/" ;
            ] , [
                sh:prefix "prov" ;
                sh:namespace "http://www.w3.org/ns/prov#" ;
            ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this ?p "VERIFIED_TRUTH" .
                {
                    SELECT $this (COUNT(?src) AS ?src_count) WHERE {
                        $this prov:wasDerivedFrom ?src .
                    }
                    GROUP BY $this
                }
                FILTER (?src_count < 2)
            }
        """ ;
    ] .

# 4. SKOS Concept must have prefLabel and be in a Scheme
onto:SKOSConceptShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every skos:Concept must have exactly one skos:prefLabel." ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:message "Every skos:Concept must belong to a skos:ConceptScheme via skos:inScheme." ;
    ] .

# 5. SKOS ConceptScheme must have a prefLabel
onto:SKOSSchemeShape
    a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Every skos:ConceptScheme must carry a skos:prefLabel." ;
    ] .

# 6. Audited Software Agent must have a readable label
onto:SoftwareAgentShape
    a sh:NodeShape ;
    sh:targetClass prov:SoftwareAgent ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "SoftwareAgent must carry an rdfs:label." ;
    ] .

# 7. Enterprise Dataset Cataloging Shape (Dublin Core + DCAT)
onto:DCATDatasetShape
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:message "Every dcat:Dataset must have a dcterms:title." ;
    ] ;
    sh:property [
        sh:path dcterms:creator ;
        sh:minCount 1 ;
        sh:message "Every dcat:Dataset must have a dcterms:creator attribution." ;
    ] ;
    sh:property [
        sh:path dcterms:created ;
        sh:minCount 1 ;
        sh:message "Every dcat:Dataset must carry a dcterms:created timestamp." ;
    ] .

