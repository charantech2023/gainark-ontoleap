# GainARK OntoLeap — environment reference
#
# Copy to .env for local development, or set these as secrets in your deployment.
# .env is gitignored, dockerignored and gcloudignored. Never commit real values.

# ---------------------------------------------------------------------------
# Authentication (STRONGLY RECOMMENDED IN PRODUCTION)
# ---------------------------------------------------------------------------
# When set, every endpoint except /, /dashboard, /api/health, /api/info and
# /api/v1/mcp-info requires this key in the "x-api-key" header (an
# "Authorization: Bearer <key>" header is also accepted).
#
# When UNSET the API is fully open: anyone who can reach the service can make it
# crawl arbitrary URLs and spend your metered Gemini / Google Knowledge Graph
# quota. A warning is logged at startup in that case.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ONTOLEAP_API_KEY=

# Run with no authentication at all. The service refuses to start without a key unless
# this is set, so an open deployment is something someone chose rather than something
# nobody noticed. For a local dev box; never for anything reachable from the internet.
ONTOLEAP_ALLOW_UNAUTHENTICATED=

# ---------------------------------------------------------------------------
# Third-party API credentials (all optional; each feature degrades gracefully)
# ---------------------------------------------------------------------------
# Google Gemini — live search simulation, content briefs, LLM-as-judge draft review.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_ATTEMPTS=3

# Google Knowledge Graph Search API — brand entity verification.
GOOGLE_KG_API_KEY=
GOOGLE_KG_MAX_RETRIES=2
GOOGLE_KG_TIMEOUT=10

# Firecrawl — managed anti-bot scraping fallback.
FIRECRAWL_API_KEY=

# Jina Reader (r.jina.ai) — fetch and render pages remotely, ahead of every local
# fetch level. Set ONTOLEAP_JINA_READER=1 to enable. Target URLs are sent to Jina.
# Without a key the free tier allows 20 requests/minute, with one 500; reads are held
# under JINA_RPM_KEYLESS / JINA_RPM, and a read that cannot get a slot within
# JINA_RATE_WAIT_SECONDS is fetched directly. A key Jina refuses (401, or 402 when the
# balance is spent) is set aside for JINA_KEY_RETRY_SECONDS and reads continue keyless;
# a 429 pauses the reader for JINA_COOLDOWN_SECONDS.
# The site crawl reads pages as trimmed markdown (1-4k tokens a page) rather than
# rendered HTML (120-190k), which is what the rest of the app still asks for.
# robots.txt, sitemaps and .json/.yaml specs always bypass it.
# In production JINA_API_KEY comes from Secret Manager (secret: jina-api-key).
ONTOLEAP_JINA_READER=0
JINA_API_KEY=
JINA_COOLDOWN_SECONDS=60
JINA_RPM=450
JINA_RPM_KEYLESS=18
JINA_RATE_WAIT_SECONDS=20
JINA_KEY_RETRY_SECONDS=900
# Pages a site crawl fetches at once.
ONTOLEAP_FETCH_CONCURRENCY=6

# ---------------------------------------------------------------------------
# Network / CORS
# ---------------------------------------------------------------------------
# Comma-separated allowlist of browser origins. Leave unset to use the built-in
# defaults. Setting this to "*" disables credentialed CORS (and is logged).
ALLOWED_ORIGINS=

# Number of trusted reverse proxies in front of this service. The rate limiter
# reads the client address this many hops from the right of X-Forwarded-For.
# Cloud Run appends exactly one. Set to 0 when there is no proxy, so the header
# is ignored entirely and cannot be used to evade rate limits.
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Resource ceilings
# ---------------------------------------------------------------------------
# Largest accepted request body, in bytes (default 4 MiB).
MAX_REQUEST_BYTES=4194304

# Largest page the crawler will read from a remote host, in bytes (default 5 MiB).
MAX_RESPONSE_BYTES=5242880

# Redirect hops followed during a fetch. Every hop is re-validated against the
# SSRF policy before it is taken.
MAX_REDIRECTS=5

# Wall-clock budget for a single SPARQL query, in seconds.
SPARQL_TIMEOUT_SECONDS=10

# Maximum distinct vertical pipelines held in memory at once. Each holds a
# reference to the shared GLiNER model.
MAX_CACHED_PIPELINES=16

# Maximum auto-discovered vertical profiles stored under verticals/.
MAX_VERTICAL_PROFILES=200

# Truth-ledger size ceiling before rotation, and read window, respectively.
MAX_HISTORY_BYTES=33554432
MAX_SNAPSHOTS_LOADED=20000

# ---------------------------------------------------------------------------
# Development only — do not set in production
# ---------------------------------------------------------------------------
# Allow fetching hosts that DNS cannot resolve. Off by default: an unresolvable
# name cannot be proven to be external, so it is refused (fail closed). Enable
# only for offline test environments using mock hosts.
# ONTOLEAP_ALLOW_UNRESOLVABLE_HOSTS=0

# Enable uvicorn auto-reload when running `python api.py` directly.
# DEV_RELOAD=0
