.gcloudignore
.git
.gitignore
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.log
scratch/
verify_*.py
*.bak
# Never upload local secrets to the Cloud Build staging bucket.
.env
.env.*
.ontoleap_cache/
.test_cache/
# test_*.py and eval/ are uploaded: cloudbuild.yaml runs the tests before it pushes.
# .dockerignore is what keeps them out of the image.
# Local run state. The service reads truth_ledger/graph.sqlite as its graph index, so
# shipping it put laptop test runs into production (revision 00070). Production state
# comes from ONTOLEAP_GRAPH_ARCHIVE and ONTOLEAP_VERTICALS_MIRROR at startup.
truth_ledger/graph.sqlite
truth_ledger/jobs/
truth_ledger/registry_archive/
# Claude Code worktrees and settings: full copies of the repo, some stale.
.claude/
